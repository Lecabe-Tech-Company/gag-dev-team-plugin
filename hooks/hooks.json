{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/scripts/check_scripta.py\"",
            "commandWindows": "cmd.exe /d /c py -3 \"%PLUGIN_ROOT%/hooks/scripts/check_scripta.py\"",
            "timeout": 35,
            "additionalContextLimit": 7000,
            "statusMessage": "Verificando acesso ao Scripta e ao projeto renew-it"
          },
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/scripts/graphify_hook.py\" session",
            "commandWindows": "cmd.exe /d /c py -3 \"%PLUGIN_ROOT%/hooks/scripts/graphify_hook.py\" session",
            "timeout": 300,
            "statusMessage": "Verificando e instalando Graphify se necessário"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/scripts/graphify_hook.py\" pre-pr",
            "commandWindows": "cmd.exe /d /c py -3 \"%PLUGIN_ROOT%/hooks/scripts/graphify_hook.py\" pre-pr",
            "timeout": 600,
            "statusMessage": "Verificando análise Graphify antes do PR"
          }
        ]
      }
    ]
  }
}
