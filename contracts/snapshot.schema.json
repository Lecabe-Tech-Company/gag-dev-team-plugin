{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gag-dev-team.local/contracts/snapshot.schema.json",
  "title": "GAG personal environment snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "binding", "plugin_version", "revision", "as_of", "capabilities",
    "environment", "rules", "skills", "sessions", "issues", "models", "token_usage", "extensions",
    "diagnostics", "events", "next_cursor"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "user"],
      "properties": {
        "project_id": { "type": "string" },
        "user": { "$ref": "#/$defs/user" }
      }
    },
    "plugin_version": { "type": ["string", "null"] },
    "revision": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "format": "date-time" },
    "capabilities": { "type": "object", "additionalProperties": { "type": "boolean" } },
    "environment": { "type": "object", "additionalProperties": true },
    "rules": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "skills": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "sessions": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "issues": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "models": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "token_usage": { "type": "object", "additionalProperties": true },
    "extensions": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "diagnostics": { "type": "array", "items": { "type": "string" } },
    "events": { "type": "array", "items": { "$ref": "environment-event.schema.json" } },
    "next_cursor": { "type": ["string", "null"] }
  },
  "$defs": {
    "user": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "host", "id", "login"],
      "properties": {
        "provider": { "const": "github" },
        "host": { "type": "string" },
        "id": { "type": "integer", "minimum": 1 },
        "login": { "type": "string", "minLength": 1 }
      }
    }
  }
}
